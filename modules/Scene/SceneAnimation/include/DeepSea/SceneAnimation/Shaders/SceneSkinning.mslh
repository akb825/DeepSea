#pragma once

/**
 * @file
 * @brief Uniform and function for the default skinning implementation for scenes.
 */

/**
 * @brief Constant for skinning using buffers.
 */
#define DS_SKIN_BUFFERS 0

/**
 * @brief Constant for skinning using texture buffers.
 */
#define DS_SKIN_TEXTURE_BUFFERS 1

/**
 * @brief Constant for skinning using basic texture.
 */
#define DS_SKIN_TEXTURES 2

/**
 * @brief Define for which skinning method to use.
 *
 * This may be explicitly set, otherwise it will use the best method as detected at compile time.
 * This will not reflect device support at runtime, however, such as OpenGL ES 3.2 devices that
 * don't support uniform buffers in vertex shaders.
 */
#ifndef DS_SKINNING_METHOD
#if HAS_BUFFERS
#define DS_SKINNING_METHOD DS_SKIN_BUFFERS
#elif (defined(GLSL_VERSION && GLSL_VERSION < 130) || \
	(defined(GLSLES_VERSION && GLSLES_VERSION < 300)
#define DS_SKINNING_METHOD DS_SKIN_TEXTURES
#else
#define DS_SKINNING_METHOD DS_SKIN_TEXTURE_BUFFERS
#endif
#endif

#if DS_SKINNING_METHOD == DS_SKIN_BUFFERS
#include <DeepSea/Animation/Shaders/SkinBuffer.mslh>
#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURE_BUFFERS
#include <DeepSea/Animation/Shaders/SkinTextureBuffer.mslh>
#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURES
#include <DeepSea/Animation/Shaders/SkinTexture.mslh>
#else
#error Unknown skinning method.
#endif

#if DS_SKINNING_METHOD == DS_SKIN_BUFFERS

/**
 * @brief The type for the bone index vector.
 */
#define DS_BONE_INDICES_TYPE uvec4

/**
 * @brief Uniform containing the skinning data.
 */
readonly buffer dsSkinningData
{
	mat4[] matrices;
} dsSkinning;

#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURE_BUFFERS

/**
 * @brief The type for the bone index vector.
 */
#define DS_BONE_INDICES_TYPE uvec4

/**
 * @brief Uniform containing the texture information for skinning.
 *
 * This uses the least-common denominator where attaching sub-ranges of buffers aren't supported
 * on all platforms. The most optimal case is expected to be with buffers.
 */
uniform dsSkinningTextureData
{
	uint offset;
} dsSkinningTextureInfo;

/**
 * @brief Texture containing the skinning data.
 */
uniform samplerBuffer dsSkinningData;

#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURES

#if HAS_INTEGERS
#define DS_BONE_INDICES_TYPE uvec4
#else
#define DS_BONE_INDICES_TYPE vec4
#endif

/**
 * @brief Uniform containing the texture information for skinning.
 */
uniform dsSkinningTextureData
{
	vec2 instanceOffsetStep;
} dsSkinningTextureInfo;

/**
 * @brief Texture containing the skinning data.
 */
uniform sampler2D dsSkinningData;
sampler_state dsSkinningData
{
	address_mode_u = clamp_to_edge;
	address_mode_v = clamp_to_edge;
	min_filter = nearest;
	mag_filter = nearest;
	mip_filter = nearest;
}

#endif

/**
 * @brief Computes the skin transform.
 * @param bones The bone indices.
 * @param weights The transform weights.
 * @return The skin transform.
 */
[[vertex]]
mat4 dsComputeSkinTransform(DS_BONE_INDICES_TYPE bones, vec4 weights)
{
#if DS_SKINNING_METHOD == DS_SKIN_BUFFERS
	return dsComputeSkinTransformBuffer(bones, weights, dsSkinning.matrices);
#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURE_BUFFERS
	return dsComputeSkinTransformTextureBuffer(
		bones, weights, dsSkinningData, INSTANCE(dsSkinningTextureInfo).offset);
#elif DS_SKINNING_METHOD == DS_SKIN_TEXTURES
	return dsComputeSkinTransformTexture(bones, weights, dsSkinningData,
		INSTANCE(dsSkinningTextureInfo).instanceOffsetStep.x,
		vec2(INSTANCE(dsSkinningTextureInfo).instanceOffsetStep.y));
#endif
}
