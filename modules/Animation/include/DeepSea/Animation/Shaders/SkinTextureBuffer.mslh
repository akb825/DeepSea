#pragma once

/**
 * @file
 * @brief Functions to perform skinning using a texture buffer.
 */

/**
 * @brief Computes the skin transform from a texture buffer.
 * @param bones The bone indices.
 * @param weights The transform weights.
 * @parma matrices The texture buffer containing the matrices.
 * @param offset The offset into the matrix texture as number of vec4 elements.
 * @return The skin transform.
 */
mat4 dsComputeSkinTransformTextureBuffer(
	uvec4 bones, vec4 weights, samplerBuffer matrices, uint offset)
{
	ivec4 matrixIndices = ivec4(offset) + ivec4(bones)*4;
	ivec4 indexOffsets = ivec4(0, 1, 2, 3);

	ivec4 thisBoneIndices = ivec4(matrixIndices.x) + indexOffsets;
	mat4 bone0Transform = mat4(
		texelFetch(matrices, thisBoneIndices.x),
		texelFetch(matrices, thisBoneIndices.y),
		texelFetch(matrices, thisBoneIndices.z),
		texelFetch(matrices, thisBoneIndices.w));

	thisBoneIndices = ivec4(matrixIndices.y) + indexOffsets;
	mat4 bone1Transform = mat4(
		texelFetch(matrices, thisBoneIndices.x),
		texelFetch(matrices, thisBoneIndices.y),
		texelFetch(matrices, thisBoneIndices.z),
		texelFetch(matrices, thisBoneIndices.w));

	thisBoneIndices = ivec4(matrixIndices.z) + indexOffsets;
	mat4 bone2Transform = mat4(
		texelFetch(matrices, thisBoneIndices.x),
		texelFetch(matrices, thisBoneIndices.y),
		texelFetch(matrices, thisBoneIndices.z),
		texelFetch(matrices, thisBoneIndices.w));

	thisBoneIndices = ivec4(matrixIndices.w) + indexOffsets;
	mat4 bone3Transform = mat4(
		texelFetch(matrices, thisBoneIndices.x),
		texelFetch(matrices, thisBoneIndices.y),
		texelFetch(matrices, thisBoneIndices.z),
		texelFetch(matrices, thisBoneIndices.w));

	return weights.x*bone0Transform + weights.y*bone1Transform + weights.z*bone2Transform +
		weights.w*bone3Transform;
}
